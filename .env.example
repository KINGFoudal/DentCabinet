# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environnement : "development" en local (nécessaire pour la simulation avec `next start`),
# "production" sur le déploiement réel.
NIMBA_ENV=development

# Paiements mobiles : "sandbox" simule les opérateurs (refusé en production), "live" appelle
# les vraies API. Sans valeur, les paiements mobiles sont désactivés.
PAYMENTS_MODE=sandbox
# Secret HMAC des notifications simulées (obligatoire en sandbox) : openssl rand -hex 32
PAYMENTS_SANDBOX_SECRET=
