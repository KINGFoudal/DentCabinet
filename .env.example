# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
